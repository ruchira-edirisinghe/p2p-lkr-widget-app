<?xml version="1.0" encoding="utf-8"?>

<!-- Reference exchange rate for any pair. Opens WidgetConfigActivity to pick the
     pair and theme; on Android 12+ that step is optional (it starts on the
     converter's pair) and can be reopened from the widget's long-press menu. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:configure="dev.dfanso.lkrp2p.ui.WidgetConfigActivity"
    android:description="@string/fx_widget_description"
    android:initialLayout="@layout/fx_widget_preview"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/fx_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
