<?xml version="1.0" encoding="utf-8"?>
<!-- RupeeRadar mark: radar rings and a sweep, with the rising rate line
     ending in a blip. Kept inside the adaptive-icon safe zone (r = 33).
     No exchange or token marks. play/make_icon.py draws the same. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Sweep: a 60-degree wedge brightening towards its leading edge. -->
    <path android:pathData="M54,54L69,28.02A30,30 0,0 1,84 54Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                <item android:offset="0.0" android:color="#66FFFFFF" />
                <item android:offset="0.0001" android:color="#00FFFFFF" />
                <item android:offset="0.8333" android:color="#00FFFFFF" />
                <item android:offset="1.0" android:color="#66FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,24a30,30 0,1 1,0 60a30,30 0,1 1,0 -60z"
        android:strokeColor="#40FFFFFF" android:strokeWidth="2.2" android:fillColor="#00000000" />
    <path android:pathData="M54,34a20,20 0,1 1,0 40a20,20 0,1 1,0 -40z"
        android:strokeColor="#4DFFFFFF" android:strokeWidth="2.2" android:fillColor="#00000000" />
    <path android:pathData="M54,44a10,10 0,1 1,0 20a10,10 0,1 1,0 -20z"
        android:strokeColor="#59FFFFFF" android:strokeWidth="2.2" android:fillColor="#00000000" />
    <!-- The rising rate line. -->
    <path android:pathData="M28,70L42,60L53,65L76,40"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="5.5"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- The blip and its halo. -->
    <path android:pathData="M76,32a8,8 0,1 1,0 16a8,8 0,1 1,0 -16z" android:fillColor="#4DFFFFFF" />
    <path android:pathData="M76,35.5a4.5,4.5 0,1 1,0 9a4.5,4.5 0,1 1,0 -9z" android:fillColor="#FFFFFFFF" />
</vector>
