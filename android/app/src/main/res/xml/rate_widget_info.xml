<?xml version="1.0" encoding="utf-8"?>

<!-- Default size is the full reference card (4x4); every instance can be resized
     down to a 2x1 strip, and the layout picks a tier from the real size. -->
<!-- previewLayout and targetCell* apply on Android 12+; older launchers use
     previewImage and minWidth/minHeight instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_preview"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
